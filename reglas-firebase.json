{
  "rules": {
    ".read": false,
    ".write": false,
    "confirmaciones": {
      "$id": {
        ".write": "!data.exists() && newData.exists() && newData.hasChildren(['nombre', 'fecha'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80"
        },
        "fecha": {
          ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
